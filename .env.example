# Template: copy to .env for `npm run start` / `docker compose up` (never committed, never copied into the image).
# Not named .env.local on purpose: Next.js loads .env.local by itself, also during `next build`.
PORT=3000
# The Nextcloud that issues the session cookies: the same host the monitor is served from.
NEXTCLOUD_URL=https://your-cloud-url
# Reports folder written by the collector (docker compose mounts it; for npm run start set a local path)
REPORTS_DIR=./volume/reports
MONITOR_GROUP=admin
