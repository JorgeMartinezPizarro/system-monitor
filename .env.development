# Loaded by `next dev` only (never by `next build`/`next start`, and never copied into the image).
# Points the dashboard at the sample reports in ./mock; run `npm run mock`
# alongside `npm run dev` to see the values move.
# Override from the shell to use real data: WATCH_DIR=/srv/ideniox/monitor/reports npm run dev
WATCH_DIR=./mock
# No Nextcloud in local development. Production never sets this: there the check is always on.
MONITOR_AUTH=off
